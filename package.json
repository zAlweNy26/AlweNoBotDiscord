{
  "name": "alwenobot-discord",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy && bun run register",
    "check": "biome check . && tsc --noEmit",
    "fix": "biome check --write .",
    "test": "vitest run",
    "register": "bun run scripts/register-commands.ts",
    "types": "wrangler types",
    "d1:migrate:local": "wrangler d1 migrations apply alwenobot --local",
    "d1:migrate:remote": "wrangler d1 migrations apply alwenobot --remote"
  },
  "dependencies": {
    "ai": "^7.0.99",
    "color-convert": "^3.1.3",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "i18next": "^26.4.2",
    "workers-ai-provider": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^22.20.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.1"
  }
}
